# Copy to .env and fill. NEVER commit .env.
# Default mode is the safest one. canary/live require additional gates.
MODE=observe

# --- RPC / data sources -------------------------------------------------
# All optional: the system runs on public endpoints without any key.
# Supplying a Helius key materially improves rate limits and WSS stability.
HELIUS_API_KEY=
SOLANA_RPC_HTTP=
SOLANA_RPC_WS=
# Read-only fallback used for reconciliation / quorum checks.
SOLANA_RPC_HTTP_FALLBACK=

# Jupiter: keyless works against lite-api.jup.ag with lower limits.
JUPITER_API_KEY=
GOPLUS_ACCESS_TOKEN=

# --- Signing (canary/live only) -----------------------------------------
# Prefer a keypair FILE PATH over raw key material in the environment.
# This must be a dedicated low-balance trading wallet, never a primary wallet.
TRADING_KEYPAIR_PATH=
# Acknowledgement file, MUST live outside this repository.
LIVE_ACK_PATH=

# --- Storage ------------------------------------------------------------
DATA_DIR=./data
DATABASE_PATH=./data/runtime.db

# --- Optional alerting --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk ---------------------------------------------------------------
# Declared NAV ceiling in SOL. Caps may be tightened here, never loosened.
MAX_NAV_SOL=
